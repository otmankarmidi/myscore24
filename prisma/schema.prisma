generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Country {
  id           String        @id @default(cuid())
  name         String
  code         String?
  flag         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  competitions Competition[]

  @@map("countries")
}

model Competition {
  id          String    @id @default(cuid())
  providerId  Int       @unique
  name        String
  type        String?
  logo        String?
  countryId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  country     Country?  @relation(fields: [countryId], references: [id], onDelete: SetNull)
  seasons     Season[]
  matches     Match[]
  playerSeasonStatistics PlayerSeasonStatistic[]

  @@index([countryId])
  @@map("competitions")
}

model Season {
  id            String      @id @default(cuid())
  competitionId String
  year          Int
  startDate     DateTime?
  endDate       DateTime?
  current       Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  matches       Match[]

  @@unique([competitionId, year])
  @@index([competitionId])
  @@map("seasons")
}

model Team {
  id            String    @id @default(cuid())
  providerId    Int       @unique
  name          String
  code          String?
  country       String?
  founded       Int?
  national      Boolean   @default(false)
  logo          String?

  venueId       Int?
  venueName     String?
  venueAddress  String?
  venueCity     String?
  venueCapacity Int?
  venueSurface  String?
  venueImage    String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastSyncedAt  DateTime?

  homeMatches   Match[]   @relation("HomeTeamMatches")
  awayMatches   Match[]   @relation("AwayTeamMatches")

  clubPlayers            Player[]                @relation("PlayerCurrentClub")
  nationalPlayers        Player[]                @relation("PlayerCurrentNationalTeam")
  playerSeasonStatistics PlayerSeasonStatistic[]
  fantasyPlayers         FantasyPlayer[]

  @@map("teams")
}

model Match {
  id                 String      @id @default(cuid())
  providerFixtureId  Int         @unique

  competitionId      String
  seasonId           String

  homeTeamId         String
  awayTeamId         String

  kickoff            DateTime
  timezone           String?
  round              String?

  status             String
  statusLong         String?
  elapsed            Int?

  homeScore          Int?
  awayScore          Int?

  halftimeHome       Int?
  halftimeAway       Int?

  fulltimeHome       Int?
  fulltimeAway       Int?

  extraTimeHome      Int?
  extraTimeAway      Int?

  penaltyHome        Int?
  penaltyAway        Int?

  venueId            Int?
  venueName          String?
  venueCity          String?

  referee            String?

  isFinal            Boolean     @default(false)

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  lastSyncedAt       DateTime?

  competition        Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  season             Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  homeTeam           Team        @relation("HomeTeamMatches", fields: [homeTeamId], references: [id], onDelete: Cascade)
  awayTeam           Team        @relation("AwayTeamMatches", fields: [awayTeamId], references: [id], onDelete: Cascade)

  fantasyGameweekFixtures  FantasyGameweekFixture[]
  fantasyPlayerMatchPoints FantasyPlayerMatchPoints[]

  // Performance Indexes for high-frequency queries
  @@index([kickoff])
  @@index([status])
  @@index([competitionId])
  @@index([seasonId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([status, kickoff])
  @@index([competitionId, kickoff])
  @@map("matches")
}

model ImportJob {
  id                    String    @id @default(cuid())
  provider              String    @default("api-football")
  competitionProviderId Int
  season                Int
  status                String    @default("PENDING") // PENDING, RUNNING, PAUSED, COMPLETED, FAILED

  fixturesProcessed     Int       @default(0)
  fixturesCreated       Int       @default(0)
  fixturesUpdated       Int       @default(0)
  fixturesSkipped       Int       @default(0)

  requestsUsed          Int       @default(0)
  lastError             String?   @db.Text

  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([competitionProviderId, season])
  @@index([status])
  @@map("import_jobs")
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  articles    Article[]

  @@map("categories")
}

model Author {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  role      String?   @default("Staff Writer")
  avatar    String?
  bio       String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  articles  Article[]

  @@map("authors")
}

model Tag {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  articles  ArticleTag[]

  @@map("tags")
}

model ArticleTag {
  articleId String
  tagId     String

  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("article_tags")
}

model Article {
  id              String        @id @default(cuid())
  title           String        @db.VarChar(255)
  slug            String        @unique @db.VarChar(255)
  excerpt         String        @db.Text
  content         String        @db.LongText
  featuredImage   String?       @db.VarChar(500)
  language        String        @default("en") @db.VarChar(10)
  translationGroupId String?    @db.VarChar(100)
  status          ArticleStatus @default(DRAFT)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  views           Int           @default(0)

  metaTitle       String?       @db.VarChar(255)
  metaDescription String?       @db.VarChar(500)
  keywords        Json?

  categoryId      String?
  authorId        String?

  category        Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author          Author?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tags            ArticleTag[]

  // Optional football entity links
  competitionId   String?       @db.VarChar(100)
  teamId          String?       @db.VarChar(100)
  playerId        String?       @db.VarChar(100)
  matchId         String?       @db.VarChar(100)

  @@index([status])
  @@index([publishedAt])
  @@index([language])
  @@index([translationGroupId])
  @@index([categoryId])
  @@index([authorId])
  @@index([competitionId])
  @@index([teamId])
  @@map("articles")
}

model Player {
  id                     String    @id @default(cuid())
  providerPlayerId       Int       @unique
  name                   String
  firstname              String?
  lastname               String?
  photo                  String?
  currentClubId          String?
  currentClubProviderId  Int?
  currentNationalTeamId  String?
  currentNationalProviderId Int?
  currentSquadNumber     Int?
  currentPosition        String?
  nationality            String?
  nationalityFlag        String?
  dateOfBirth            String?
  age                    Int?
  height                 String?
  weight                 String?
  preferredFoot          String?
  marketValue            String?
  lastSyncedAt           DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  currentClub            Team?     @relation("PlayerCurrentClub", fields: [currentClubId], references: [id], onDelete: SetNull)
  currentNationalTeam    Team?     @relation("PlayerCurrentNationalTeam", fields: [currentNationalTeamId], references: [id], onDelete: SetNull)
  seasonStatistics       PlayerSeasonStatistic[]

  @@index([currentClubId])
  @@index([currentNationalTeamId])
  @@index([currentClubProviderId])
  @@map("players")
}

model PlayerSeasonStatistic {
  id                 String       @id @default(cuid())
  playerId           String
  teamId             String?
  competitionId      String?

  providerPlayerId   Int
  providerTeamId     Int
  providerLeagueId   Int
  season             Int

  leagueName         String
  leagueLogo         String?
  leagueCountry      String?
  leagueFlag         String?
  isCalendarYear     Boolean      @default(false)

  teamName           String
  teamLogo           String?

  appearances        Int?
  lineups            Int?
  minutes            Int?
  number             Int?
  position           String?
  rating             Float?
  captain            Boolean      @default(false)

  goals              Int?
  conceded           Int?
  assists            Int?
  saves              Int?

  shotsTotal         Int?
  shotsOnTarget      Int?

  passesTotal        Int?
  passesKey          Int?
  passesAccuracy     Int?

  tacklesTotal       Int?
  blocks             Int?
  interceptions      Int?

  duelsTotal         Int?
  duelsWon           Int?

  dribblesAttempts   Int?
  dribblesSuccess    Int?

  foulsDrawn         Int?
  foulsCommitted     Int?

  yellowCards        Int?
  yellowRedCards     Int?
  redCards           Int?

  penaltyWon         Int?
  penaltyCommited    Int?
  penaltyScored      Int?
  penaltyMissed      Int?
  penaltySaved       Int?

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  player             Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team               Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  competition        Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)

  @@unique([providerPlayerId, providerTeamId, providerLeagueId, season], map: "player_season_stat_unique")
  @@index([playerId])
  @@index([season])
  @@index([providerTeamId])
  @@index([providerLeagueId])
  @@map("player_season_statistics")
}

model FantasyUser {
  id              String                @id @default(cuid())
  email           String                @unique
  passwordHash    String                @db.VarChar(255)
  managerName     String                @db.VarChar(100)
  teamName        String                @unique @db.VarChar(100)
  favoriteClubId  String?
  role            String                @default("USER") @db.VarChar(20)
  avatar          String?               @db.VarChar(255)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  squad             FantasySquad?
  leagueMemberships FantasyLeagueMember[]
  createdLeagues    FantasyLeague[]       @relation("LeagueAdmin")

  @@map("fantasy_users")
}

model FantasyGameweek {
  id            String    @id @default(cuid())
  gameweekNumber Int
  seasonYear    Int
  competitionId String
  name          String    @db.VarChar(100)
  deadline      DateTime
  status        String    @default("UPCOMING") @db.VarChar(30)
  isCurrent     Boolean   @default(false)
  totalFixtures Int       @default(10)
  scoredAt      DateTime?
  finalizedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  fixtures             FantasyGameweekFixture[]
  snapshots            FantasyGameweekSquadSnapshot[]
  transfers            FantasyTransfer[]
  playerMatchPoints    FantasyPlayerMatchPoints[]
  playerGameweekPoints FantasyPlayerGameweekPoints[]
  managerGameweekPoints FantasyManagerGameweekPoints[]

  @@unique([competitionId, seasonYear, gameweekNumber], map: "uq_competition_season_gameweek")
  @@index([status])
  @@index([isCurrent])
  @@map("fantasy_gameweeks")
}

model FantasyGameweekFixture {
  id         String   @id @default(cuid())
  gameweekId String
  matchId    String
  isScored   Boolean  @default(false)
  createdAt  DateTime @default(now())

  gameweek   FantasyGameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)
  match      Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([gameweekId, matchId], map: "uq_gameweek_match")
  @@index([matchId])
  @@map("fantasy_gameweek_fixtures")
}

model FantasyPlayer {
  id                 String    @id @default(cuid())
  playerId           String?
  providerPlayerId   Int?
  name               String
  webName            String    @db.VarChar(100)
  teamId             String
  teamProviderId     Int
  teamShortName      String    @db.VarChar(20)
  position           String    @db.VarChar(10) // GKP, DEF, MID, FWD
  price              Float
  startPrice         Float
  status             String    @default("AVAILABLE") @db.VarChar(30)
  news               String?   @db.VarChar(255)
  chanceOfPlaying    Int?
  totalPoints        Int       @default(0)
  goalsTotal         Int       @default(0)
  assistsTotal       Int       @default(0)
  cleanSheetsTotal   Int       @default(0)
  minutesTotal       Int       @default(0)
  yellowCardsTotal   Int       @default(0)
  redCardsTotal      Int       @default(0)
  photo              String?   @db.VarChar(500)
  selectedByPercent  Float     @default(0.0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  team           Team                         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  squadPlayers   FantasySquadPlayer[]
  priceHistories FantasyPlayerPriceHistory[]
  matchPoints    FantasyPlayerMatchPoints[]
  gameweekPoints FantasyPlayerGameweekPoints[]

  @@index([teamId])
  @@index([position])
  @@index([price])
  @@index([totalPoints])
  @@index([providerPlayerId])
  @@map("fantasy_players")
}

model FantasyPlayerPriceHistory {
  id              String   @id @default(cuid())
  fantasyPlayerId String
  gameweekNumber  Int
  oldPrice        Float
  newPrice        Float
  changeReason    String?  @db.VarChar(255)
  createdAt       DateTime @default(now())

  fantasyPlayer   FantasyPlayer @relation(fields: [fantasyPlayerId], references: [id], onDelete: Cascade)

  @@index([fantasyPlayerId])
  @@map("fantasy_player_price_histories")
}

model FantasySquad {
  id                  String    @id @default(cuid())
  userId              String    @unique
  competitionId       String
  seasonYear          Int
  teamName            String    @db.VarChar(100)
  bank                Float     @default(0.0)
  squadValue          Float     @default(100.0)
  freeTransfers       Int       @default(1)
  totalTransfers      Int       @default(0)
  totalPoints         Int       @default(0)
  overallRank         Int?
  activeChip          String?   @db.VarChar(30)
  wildcardUsedAt      DateTime?
  tripleCaptainUsedAt DateTime?
  benchBoostUsedAt    DateTime?
  freeHitUsedAt       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                  FantasyUser                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  players               FantasySquadPlayer[]
  snapshots             FantasyGameweekSquadSnapshot[]
  transfers             FantasyTransfer[]
  managerGameweekPoints FantasyManagerGameweekPoints[]
  leagueMemberships     FantasyLeagueMember[]

  @@index([totalPoints])
  @@map("fantasy_squads")
}

model FantasySquadPlayer {
  id              String   @id @default(cuid())
  squadId         String
  fantasyPlayerId String
  positionIndex   Int
  isStartingXI    Boolean  @default(true)
  isCaptain       Boolean  @default(false)
  isViceCaptain   Boolean  @default(false)
  purchasePrice   Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  squad         FantasySquad  @relation(fields: [squadId], references: [id], onDelete: Cascade)
  fantasyPlayer FantasyPlayer @relation(fields: [fantasyPlayerId], references: [id], onDelete: Cascade)

  @@unique([squadId, fantasyPlayerId], map: "uq_squad_player")
  @@index([squadId])
  @@index([fantasyPlayerId])
  @@map("fantasy_squad_players")
}

model FantasyGameweekSquadSnapshot {
  id             String   @id @default(cuid())
  squadId        String
  gameweekId     String
  gameweekNumber Int
  activeChip     String?  @db.VarChar(30)
  snapshotJson   Json
  createdAt      DateTime @default(now())

  squad    FantasySquad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  gameweek FantasyGameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)

  @@unique([squadId, gameweekId], map: "uq_snapshot_squad_gw")
  @@index([gameweekId])
  @@map("fantasy_gameweek_squad_snapshots")
}

model FantasyTransfer {
  id              String   @id @default(cuid())
  squadId         String
  gameweekId      String
  gameweekNumber  Int
  playerInId      String
  playerOutId     String
  playerInPrice   Float
  playerOutPrice  Float
  isFreeTransfer  Boolean  @default(true)
  pointCost       Int      @default(0)
  createdAt       DateTime @default(now())

  squad    FantasySquad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  gameweek FantasyGameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)

  @@index([squadId])
  @@index([gameweekId])
  @@map("fantasy_transfers")
}

model FantasyPlayerMatchPoints {
  id              String   @id @default(cuid())
  fantasyPlayerId String
  matchId         String
  gameweekId      String
  minutesPlayed   Int      @default(0)
  goalsScored     Int      @default(0)
  assists         Int      @default(0)
  cleanSheet      Boolean  @default(false)
  goalsConceded   Int      @default(0)
  ownGoals        Int      @default(0)
  penaltiesSaved  Int      @default(0)
  penaltiesMissed Int      @default(0)
  yellowCards     Int      @default(0)
  redCards        Int      @default(0)
  saves           Int      @default(0)
  bonusPoints     Int      @default(0)
  totalPoints     Int      @default(0)
  breakdown       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fantasyPlayer FantasyPlayer   @relation(fields: [fantasyPlayerId], references: [id], onDelete: Cascade)
  match         Match           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gameweek      FantasyGameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)

  @@unique([fantasyPlayerId, matchId], map: "uq_pmp_player_match")
  @@index([gameweekId])
  @@index([matchId])
  @@map("fantasy_player_match_points")
}

model FantasyPlayerGameweekPoints {
  id              String   @id @default(cuid())
  fantasyPlayerId String
  gameweekId      String
  totalPoints     Int      @default(0)
  minutesPlayed   Int      @default(0)
  goalsScored     Int      @default(0)
  assists         Int      @default(0)
  cleanSheets     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fantasyPlayer FantasyPlayer   @relation(fields: [fantasyPlayerId], references: [id], onDelete: Cascade)
  gameweek      FantasyGameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)

  @@unique([fantasyPlayerId, gameweekId], map: "uq_pgp_player_gw")
  @@index([gameweekId])
  @@map("fantasy_player_gameweek_points")
}

model FantasyManagerGameweekPoints {
  id              String   @id @default(cuid())
  squadId         String
  gameweekId      String
  gameweekNumber  Int
  grossPoints     Int      @default(0)
  transferCost    Int      @default(0)
  netPoints       Int      @default(0)
  gameweekRank    Int?
  overallPoints   Int      @default(0)
  overallRank     Int?
  pointsBreakdown Json?
  calculatedAt    DateTime @default(now())

  squad    FantasySquad    @relation(fields: [squadId], references: [id], onDelete: Cascade)
  gameweek FantasyGameweek @relation(fields: [gameweekId], references: [id], onDelete: Cascade)

  @@unique([squadId, gameweekId], map: "uq_mgp_squad_gw")
  @@index([gameweekId])
  @@map("fantasy_manager_gameweek_points")
}

model FantasyLeague {
  id            String    @id @default(cuid())
  name          String    @db.VarChar(100)
  code          String    @unique @db.VarChar(20)
  type          String    @default("PRIVATE_CLASSIC") @db.VarChar(30)
  adminUserId   String?
  competitionId String
  seasonYear    Int
  isPublic      Boolean   @default(false)
  maxMembers    Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  adminUser FantasyUser?          @relation("LeagueAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  members   FantasyLeagueMember[]

  @@index([competitionId, seasonYear])
  @@index([type])
  @@map("fantasy_leagues")
}

model FantasyLeagueMember {
  id           String   @id @default(cuid())
  leagueId     String
  userId       String
  squadId      String
  joinedAt     DateTime @default(now())
  currentRank  Int?
  previousRank Int?

  league FantasyLeague @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  squad  FantasySquad  @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user   FantasyUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, squadId], map: "uq_lm_league_squad")
  @@index([leagueId])
  @@index([userId])
  @@map("fantasy_league_members")
}

model FantasyScoringRule {
  id          String   @id @default(cuid())
  ruleKey     String   @unique @db.VarChar(50)
  description String   @db.VarChar(255)
  pointsValue Int
  category    String   @db.VarChar(30)
  updatedAt   DateTime @updatedAt

  @@map("fantasy_scoring_rules")
}

model FantasyJobExecution {
  id             String    @id @default(cuid())
  jobName        String    @db.VarChar(100)
  gameweekNumber Int?
  status         String    @default("RUNNING") @db.VarChar(30)
  payload        Json?
  errorMessage   String?   @db.Text
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([jobName])
  @@index([gameweekNumber])
  @@map("fantasy_job_executions")
}


